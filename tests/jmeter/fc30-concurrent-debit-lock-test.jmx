      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="05. Query Final Account Balance" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.domain">${HOST}</stringProp>
          <stringProp name="HTTPSampler.port">${PORT}</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/api/accounts/${__groovy(props.get(&quot;ACTIVE_ACCOUNT_ID&quot;))}/balance</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Bearer Auth Header" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Authorization</stringProp>
                <stringProp name="Header.value">Bearer ${__groovy(props.get(&quot;ACTIVE_TOKEN&quot;))}</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Accept</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract Final Balance" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">FINAL_BALANCE</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.data</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
            <stringProp name="JSONPostProcessor.defaultValues">-1</stringProp>
          </JSONPostProcessor>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert Concurrency Invariant &amp; Zero Lost Updates" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">int successCount = props.get(&quot;COUNT_201_SUCCESS&quot;).get();
int insufficientCount = props.get(&quot;COUNT_422_INSUFFICIENT&quot;).get();
int errorCount = props.get(&quot;COUNT_500_ERRORS&quot;).get();

BigDecimal initialDeposit = new BigDecimal(&quot;${INITIAL_DEPOSIT}&quot;);
BigDecimal withdrawAmount = new BigDecimal(&quot;${WITHDRAW_AMOUNT}&quot;);
BigDecimal finalBalance = new BigDecimal(vars.get(&quot;FINAL_BALANCE&quot;));

BigDecimal totalWithdrawn = withdrawAmount.multiply(new BigDecimal(successCount));
BigDecimal expectedBalance = initialDeposit.subtract(totalWithdrawn);

log.info(&quot;======================================================================&quot;);
log.info(&quot; FC-30 CONCURRENCY VERIFICATION SUMMARY&quot;);
log.info(&quot;======================================================================&quot;);
log.info(&quot;Total Concurrent Threads : 10&quot;);
log.info(&quot;Successful Debits (201)  : &quot; + successCount);
log.info(&quot;Rejected Overdrafts (422): &quot; + insufficientCount);
log.info(&quot;System Errors (500)      : &quot; + errorCount);
log.info(&quot;Initial Deposit          : &quot; + initialDeposit + &quot; PHP&quot;);
log.info(&quot;Total Withdrawn          : &quot; + totalWithdrawn + &quot; PHP&quot;);
log.info(&quot;Expected Balance         : &quot; + expectedBalance + &quot; PHP&quot;);
log.info(&quot;Actual Final Balance     : &quot; + finalBalance + &quot; PHP&quot;);
log.info(&quot;======================================================================&quot;);

if (errorCount &gt; 0) {
    AssertionResult.setFailure(true);
    AssertionResult.setFailureMessage(&quot;Concurrency Failure: Encountered &quot; + errorCount + &quot; server errors!&quot;);
    return;
}

if (finalBalance.compareTo(BigDecimal.ZERO) &lt; 0) {
    AssertionResult.setFailure(true);
    AssertionResult.setFailureMessage(&quot;CRITICAL DOUBLE-SPEND FAILURE: Account balance became negative: &quot; + finalBalance);
    return;
}

if (finalBalance.compareTo(expectedBalance) != 0) {
    AssertionResult.setFailure(true);
    AssertionResult.setFailureMessage(&quot;LOST UPDATE FAILURE: Final balance (&quot; + finalBalance + &quot;) does not equal expected balance (&quot; + expectedBalance + &quot;)&quot;);
    return;
}

log.info(&quot;[PASSED] FC-30 ACCEPTANCE CRITERIA VERIFIED!&quot;);
</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
      </hashTree>
      <ResultCollector guiclass="ViewResultsFullVisualizer" testclass="ResultCollector" testname="View Results Tree (All 16 Requests)" enabled="true">
        <boolProp name="ResultCollector.error_logging">false</boolProp>
        <objProp>
          <name>saveConfig</name>
          <value class="SampleSaveConfiguration">
            <time>true</time>
            <latency>true</latency>
            <timestamp>true</timestamp>
            <success>true</success>
            <label>true</label>
            <code>true</code>
            <message>true</message>
            <threadName>true</threadName>
            <dataType>true</dataType>
            <encoding>false</encoding>
            <assertions>true</assertions>
            <subresults>true</subresults>
            <responseData>false</responseData>
            <samplerData>false</samplerData>
            <xml>false</xml>
            <fieldNames>true</fieldNames>
            <responseHeaders>false</responseHeaders>
            <requestHeaders>false</requestHeaders>
            <responseDataOnError>false</responseDataOnError>
            <saveAssertionResultsFailureMessage>true</saveAssertionResultsFailureMessage>
            <assertionsResultsToSave>0</assertionsResultsToSave>
            <bytes>true</bytes>
            <sentBytes>true</sentBytes>
            <url>true</url>
            <threadCounts>true</threadCounts>
            <idleTime>true</idleTime>
            <connectTime>true</connectTime>
          </value>
        </objProp>
        <stringProp name="filename"></stringProp>
      </ResultCollector>
      <hashTree/>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
