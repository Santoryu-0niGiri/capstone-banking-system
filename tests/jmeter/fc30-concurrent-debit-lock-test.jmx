  &quot;txnType&quot;: &quot;WITHDRAWAL&quot;,&#xd;
  &quot;amount&quot;: ${WITHDRAW_AMOUNT},&#xd;
  &quot;idempotencyKey&quot;: &quot;${__UUID}&quot;&#xd;
}</stringProp>
