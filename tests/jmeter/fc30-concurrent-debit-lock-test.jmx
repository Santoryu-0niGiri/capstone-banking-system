  &quot;firstName&quot;: &quot;JMeter&quot;,&#xd;
  &quot;lastName&quot;: &quot;Tester&quot;,&#xd;
  &quot;email&quot;: &quot;jmeter_${__time()}@example.com&quot;,&#xd;
  &quot;contactNo&quot;: &quot;+639170003344&quot;,&#xd;
  &quot;birthDate&quot;: &quot;1992-05-15&quot;,&#xd;
  &quot;password&quot;: &quot;Password123!&quot;&#xd;
}</stringProp>
