          <stringProp name="HTTPSampler.path">/api/v1/ledger/mutate</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          <stringProp name="HTTPSampler.connect_timeout">5000</stringProp>
          <stringProp name="HTTPSampler.response_timeout">10000</stringProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 201 Created OR 422 Insufficient Balance" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="1537214">201|422</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Concurrency failure: Expected 201 (Funded) or 422 (Insufficient Balance). Received unexpected HTTP code!</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">true</boolProp>
            <intProp name="Assertion.test_type">1</intProp>
          </ResponseAssertion>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Track Concurrency Outcomes" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def code = prev.getResponseCode();
def thread = prev.getThreadName();
def latency = prev.getTime();

if (code == &quot;201&quot;) {
    props.get(&quot;COUNT_201_SUCCESS&quot;).incrementAndGet();
    log.info(&quot;[FC-30 Concurrency] &quot; + thread + &quot; -&gt; 201 CREATED (&quot; + latency + &quot; ms) [SUCCESS]&quot;);
} else if (code == &quot;422&quot;) {
    props.get(&quot;COUNT_422_INSUFFICIENT&quot;).incrementAndGet();
    log.info(&quot;[FC-30 Concurrency] &quot; + thread + &quot; -&gt; 422 UNPROCESSABLE (&quot; + latency + &quot; ms) [INSUFFICIENT FUNDS]&quot;);
} else {
    props.get(&quot;COUNT_500_ERRORS&quot;).incrementAndGet();
    log.error(&quot;[FC-30 Concurrency ERROR] &quot; + thread + &quot; -&gt; &quot; + code + &quot; (&quot; + latency + &quot; ms) Response: &quot; + prev.getResponseDataAsString());
}
</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
