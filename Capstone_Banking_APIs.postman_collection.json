    {
      "name": "3. Financial Mutations & Audit",
      "item": [
        {
          "name": "08 - Execute Deposit Mutation (POST /api/v1/ledger/mutate)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var uuid = pm.variables.replaceIn('{{$guid}}');",
                  "pm.environment.set('currentIdemKey', uuid);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.data && json.data.txnId) {",
                  "    pm.collectionVariables.set('txnId', json.data.txnId);",
                  "    console.log('Saved txnId: ' + json.data.txnId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{currentIdemKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"{{accountId}}\",\n  \"counterpartyAccountId\": null,\n  \"txnType\": \"DEPOSIT\",\n  \"amount\": 15000.0,\n  \"idempotencyKey\": \"{{currentIdemKey}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ledger/mutate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ledger",
                "mutate"
              ]
            }
          }
        },
        {
          "name": "09 - Verify Updated Balance (GET /api/accounts/{id}/balance)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{accountId}}/balance",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts",
                "{{accountId}}",
                "balance"
              ]
            }
          }
