    {
      "name": "5. RFC-7807 Error Validation",
      "item": [
        {
          "name": "13 - Error Test: Overdraft Insufficient Balance (422 Unprocessable)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var uuid = pm.variables.replaceIn('{{$guid}}');",
                  "pm.environment.set('failIdemKey', uuid);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 422 Unprocessable Entity', function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Contains RFC-7807 type URI', function () {",
                  "    pm.expect(json.type).to.include('insufficient-balance');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{failIdemKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"{{accountId}}\",\n  \"counterpartyAccountId\": null,\n  \"txnType\": \"WITHDRAWAL\",\n  \"amount\": 9999999.0,\n  \"idempotencyKey\": \"{{failIdemKey}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ledger/mutate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ledger",
                "mutate"
              ]
            }
          }
        },
        {
          "name": "14 - Error Test: Missing Idempotency Key (400 Bad Request)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"{{accountId}}\",\n  \"txnType\": \"DEPOSIT\",\n  \"amount\": 500.0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ledger/mutate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ledger",
                "mutate"
              ]
            }
          }
        }
      ]
    }
